# Configuración del ambiente
APP_ENV=development
APP_DEBUG=true

# Configuración de la base de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lasalle_dev
DB_USERNAME=root
DB_PASSWORD=TU_CONTRASENA_LOCAL

