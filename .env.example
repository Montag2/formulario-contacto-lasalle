# Configuración del Ambiente de la Aplicación
APP_ENV=development
APP_DEBUG=true

# Configuración de la Base de Datos (Ambiente Local/Desarrollo)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lasalle_dev
DB_USERNAME=root
DB_PASSWORD=admin

# NOTA PARA EL EQUIPO: 
# Copien este archivo, renómbrenlo a ".env" (sin el .example) 
# y coloquen sus credenciales locales. El archivo .env real no se subirá.